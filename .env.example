# ========================================
# FFmpeg Video API - Environment Configuration
# ========================================

# -----------------------
# Server Configuration
# -----------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# -----------------------
# Security
# -----------------------
# Generate a strong API key (32+ characters)
# Example: openssl rand -base64 32
API_KEY=your-secure-api-key-here-change-this-in-production

# -----------------------
# Storage Configuration
# -----------------------
# Options: 'r2' (Cloudflare R2), 's3' (AWS S3), 'local'
STORAGE_TYPE=local

# Cloudflare R2 Configuration (Recommended for Production - No egress fees)
# Uncomment and configure if using R2:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=videos
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://videos.yourdomain.com
# STORAGE_MAKE_PUBLIC=true

# AWS S3 Configuration (Alternative)
# Uncomment and configure if using S3:
# S3_BUCKET=my-videos
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_MAKE_PUBLIC=true

# Local Storage Configuration (Temporary storage - files auto-deleted after 12h)
# Files are served via /files/ endpoint
LOCAL_STORAGE_PATH=/app/storage/uploads
# Choose one of the following BASE_URL options:
# Option 1: Direct access via port 3000
LOCAL_STORAGE_BASE_URL=http://YOUR-VPS-IP:3000/files
# Option 2: Via Traefik with path prefix
# LOCAL_STORAGE_BASE_URL=http://YOUR-VPS-IP/ffmpeg-api/files
# Option 3: With custom domain (after DNS configuration)
# LOCAL_STORAGE_BASE_URL=https://api.yourdomain.com/files
STORAGE_MAKE_PUBLIC=true

# -----------------------
# Redis Configuration
# -----------------------
# Redis URL for job tracking and queue management
REDIS_URL=redis://redis:6379
# Alternative: redis://username:password@host:port/db
REDIS_ENABLED=true

# -----------------------
# FFmpeg Configuration
# -----------------------
# Number of threads FFmpeg should use per job
FFMPEG_THREADS=4

# Maximum number of concurrent rendering jobs
MAX_CONCURRENT_JOBS=3

# Temporary directory for downloads and processing
TEMP_DIR=/tmp/ffmpeg-api

# FFmpeg rendering timeout in seconds (default: 600 = 10 minutes)
FFMPEG_TIMEOUT=600

# Asset download timeout in seconds per file
DOWNLOAD_TIMEOUT=60

# -----------------------
# Logging Configuration
# -----------------------
# Log levels: error, warn, info, debug
LOG_LEVEL=info

# Log file directory
LOG_DIR=./logs

# Maximum log file size
LOG_MAX_SIZE=20m

# Number of days to keep logs
LOG_MAX_FILES=14d

# -----------------------
# CORS Configuration
# -----------------------
# Comma-separated list of allowed origins
# Use * for development, specific domains for production
CORS_ORIGINS=*

# -----------------------
# Rate Limiting (Optional)
# -----------------------
# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# Time window in minutes
RATE_LIMIT_WINDOW=15

# -----------------------
# Webhook Configuration (Optional)
# -----------------------
# URL to send completion webhooks to
WEBHOOK_URL=

# Webhook authentication token
WEBHOOK_SECRET=
